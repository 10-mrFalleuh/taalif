# ─── Base de données PostgreSQL ─────────────────────────────────
# DATABASE_URL : connexion utilisée au runtime. En serverless (Vercel), ce
#   DOIT être l'URL « pooled » du fournisseur, sinon les connexions sont vite
#   épuisées. Chez Neon : l'URL contenant « -pooler ».
# DIRECT_URL   : connexion directe utilisée par les migrations Prisma. Chez
#   Neon : la même URL SANS « -pooler ».
# En local (Postgres sans pooler), les deux valeurs sont identiques.
DATABASE_URL="postgresql://postgres:motdepasse@localhost:5432/taalif_db"
DIRECT_URL="postgresql://postgres:motdepasse@localhost:5432/taalif_db"

# ─── NextAuth.js ─────────────────────────────────────────────────
# Secret aléatoire fort (génère avec : openssl rand -base64 32)
NEXTAUTH_SECRET="votre-secret-nextauth-tres-long-et-aleatoire"
# URL de base en développement
NEXTAUTH_URL="http://localhost:3000"

# ─── Email (Nodemailer) ──────────────────────────────────────────
# Pour la vérification d'email et le mot de passe oublié
# Exemple avec Gmail (activer "App passwords" dans les paramètres Google)
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="votre-email@gmail.com"
EMAIL_SERVER_PASSWORD="votre-app-password-gmail"
EMAIL_FROM="TAALIF <no-reply@taalif.sn>"

# ─── Stockage fichiers ───────────────────────────────────────────
# Sans configuration Cloudinary ci-dessous, les fichiers sont écrits dans
# public/uploads. Cela ne convient qu'au développement ou à un hébergement
# disposant d'un volume persistant (VPS, conteneur avec volume monté).
#
# ⚠ SUR VERCEL / NETLIFY / LAMBDA : le disque est en lecture seule et éphémère.
# Sans Cloudinary, tout fichier uploadé en production est perdu.

# ─── Cloudinary (REQUIS en production serverless) ────────────────
# Les trois variables doivent être présentes pour activer le pilote.
# CLOUDINARY_CLOUD_NAME="votre-cloud-name"
# CLOUDINARY_API_KEY="votre-api-key"
# CLOUDINARY_API_SECRET="votre-api-secret"

# ─── Application ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="TAALIF"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Administrateur initial (script de seed) ─────────────────────
# En production, ces variables sont OBLIGATOIRES : le seed refuse de créer
# l'admin sans un mot de passe fourni ici (aucun mot de passe en dur dans le
# code). En développement, des valeurs de repli sont utilisées si absentes.
SEED_ADMIN_EMAIL="admin@taalif.sn"
SEED_ADMIN_PASSWORD="choisissez-un-mot-de-passe-fort"

# ─── Rate Limiting (Upstash Redis) ───────────────────────────────
# FORTEMENT RECOMMANDÉ EN PRODUCTION.
# Sans ces variables, le limiteur de débit (connexion, inscription, emails)
# retombe sur un compteur en mémoire : remis à zéro à chaque démarrage à froid
# et non partagé entre instances serverless, donc contournable.
# UPSTASH_REDIS_REST_URL="https://..."
# UPSTASH_REDIS_REST_TOKEN="..."
