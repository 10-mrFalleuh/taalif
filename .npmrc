# next-auth@4 déclare une dépendance de pair `nodemailer@^6`, alors que le
# projet utilise nodemailer@8. Ce pair est optionnel et ne concerne que le
# provider Email de NextAuth, non utilisé ici (authentification Credentials) :
# le conflit est sans effet à l'exécution, mais bloque npm install sans ce
# réglage. À retirer le jour où next-auth passera en v5 (Auth.js).
legacy-peer-deps=true
